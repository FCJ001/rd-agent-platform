# ============================================================
# rd-agent-platform 环境变量样例
# 用法：cp .env.example .env 然后填真实密钥
# .env 已在 .gitignore 里，绝不提交
# ============================================================

# 应用
APP_NAME=rd-agent-platform
APP_ENV=dev
APP_DEBUG=true

# PostgreSQL — 与 docker-compose.yml 的 postgres 服务对应
DB_HOST=localhost
DB_PORT=5432
DB_USER=rdagent
DB_PASSWORD=rdagent123
DB_NAME=rd_agent

# Redis Stack — 短期记忆 + 分诊状态机 checkpoint
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO — 报告/日志附件
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=alm-reports
MINIO_SECURE=false

# Milvus — 现象码向量索引 + 长期记忆
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j — 追溯图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rdagent123

# ---------------- 模型 ----------------
# ★ 绝不硬编码进源码（医疗版 scripts/init_public_datasets.py:46 犯过这个错）
DASHSCOPE_API_KEY=sk-xxxxxxxx
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v3

DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ---------------- 项目二（步 7 才用到）----------------
KNOWLEDGE_SVC_URL=http://localhost:8001

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs
