# ============================================================
# rd-agent-platform 环境变量样例
# 用法：cp .env.example .env 然后填真实密钥
# .env 已在 .gitignore 里，绝不提交
# ============================================================

# 应用
APP_NAME=rd-agent-platform
# dev=宽松（允许 X-User-Id 直通、webhook 免验签）；prod=全量安全校验，缺配置拒绝启动
APP_ENV=dev
# 生产必须 false（校验见 src/core/config.py validate_production）
APP_DEBUG=true

# PostgreSQL — 与 docker-compose.yml 的 postgres 服务对应
DB_HOST=localhost
DB_PORT=5432
DB_USER=rdagent
DB_PASSWORD=change-me-postgres
DB_NAME=rd_agent

# Redis Stack — 短期记忆 + 分诊状态机 checkpoint
# docker-compose 里 requirepass 用的是这个值，务必设置强口令
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# MinIO — 报告/日志附件
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=alm-reports
MINIO_SECURE=false

# Milvus — 现象码向量索引 + 长期记忆
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j — 追溯图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# ---------------- 安全 ----------------
# 服务自签身份令牌密钥（scripts/mint_token.py 签发 X-Auth-Token）
# 生产必填：openssl rand -hex 32
AUTH_SECRET=
# ALM 平台事件 webhook 的 HMAC 共享密钥（与 Java 平台侧一致；生产必填）
WEBHOOK_SECRET=
# CORS 白名单（逗号分隔）；dev 留空 = 全放开；prod 必须显式配置
CORS_ALLOW_ORIGINS=
# LangGraph checkpointer TTL（分钟），默认 7 天
CHECKPOINTER_TTL_MINUTES=10080
# 分诊进度（triage_state）TTL，秒，默认 8 天。
# ★ 必须严格大于 CHECKPOINTER_TTL_MINUTES×60：进度先过期、挂起的追问还活着时，
#   用户下次回答会被当成首轮重跑 —— 白烧一轮模型调用，并把历史回答重放一遍，
#   追问序列与轮次从此错位（生产启动期会直接拒绝启动）。
TRIAGE_STATE_TTL_SECONDS=691200
# chat 回合锁 TTL，秒。持有时长是整轮对话的全部工具调用（可能好几分钟），
# 正常慢任务靠续租兜住，这个 TTL 只决定「进程崩溃后多久自动解锁」。
CHAT_LOCK_TIMEOUT_SECONDS=90
# 分诊会话锁（Redis 分布式锁）TTL，秒。
# ★ 不是「用户思考时长」：interrupt() 抛异常时锁已释放，
#   真实持有时长 = 两次追问之间的 LLM 调用（秒~十几秒）。
#   给 3 分钟是给 LLM 抖动留余量 —— 过期会让并发重新进来写坏状态，
#   太大则进程被 SIGKILL 后会话被锁死。
TRIAGE_LOCK_TIMEOUT_SECONDS=180
# 抢不到锁时的重试次数与间隔（同进程连点/多标签页靠它排队；0 = 立即失败）
TRIAGE_LOCK_RETRY_TIMES=3
TRIAGE_LOCK_RETRY_INTERVAL_SECONDS=0.5
# 分诊全局并发闸门：全系统同时运行的诊断轮次上限（跨进程，chat 工具/
# REST 接口/webhook 自动分诊共用）。会话锁只防同一会话并发，不限总量；
# 超出上限的先排队（有界、限时），排不下/等不到则拒绝。≤0 = 关闭闸门
#
# 定标 100 的依据（自建 8B~14B 单卡 H100，上下文 2K~3K）：
#   KV 预算 54G ÷ 128KB/token ≈ 42 万 token ÷ 3K ≈ 180 路；
#   decode 吞吐 4k token/s ÷ 22 token/s/用户 ≈ 180 路；取小者 180 路模型
#   请求。闸门单位是「诊断轮次」（1~2 次模型请求/轮），180 ÷ 1.5 ≈ 120，
#   取 100 留余量。★ 自建引擎超额是排队不是报错，设高了只堆延迟不增吞吐；
#   模型走公司共享端点时按「该端点分给本服务的配额 ÷ 1.5」设。
TRIAGE_GLOBAL_CONCURRENCY=100
# 单进程最多同时在排队的请求数（排队的再多也只是白等，不如现在就拒绝）
TRIAGE_GATE_QUEUE_MAX=200
# 排队等空位的最长秒数，超时按「系统忙」拒绝
TRIAGE_GATE_WAIT_TIMEOUT_SECONDS=60
# 空位轮询间隔（秒），加抖动防惊群
TRIAGE_GATE_POLL_INTERVAL_SECONDS=0.5
# 空位租约（秒）：持有者进程崩溃后空位最多这么久自动归还；
# 持有期间每 1/3 租约自动续租，正常长任务不受影响
TRIAGE_GATE_LEASE_SECONDS=90

# ---------------- 模型 ----------------
# ★ 绝不硬编码进源码（医疗版 scripts/init_public_datasets.py:46 犯过这个错）
DASHSCOPE_API_KEY=sk-xxxxxxxx
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v3

DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ---------------- 项目二（步 7 才用到）----------------
KNOWLEDGE_SVC_URL=http://localhost:8001

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs

# ChatBI 独立服务（BI 查询，多数据源平台）
BI_SVC_URL=http://localhost:8004
BI_PROJECT_ID=rd_agent
